# --- Server ---
PORT=4000
MONGO_URL=mongodb://localhost:27017/sentinelx   # docker compose overrides to mongo:27017

# --- LLM (all calls go through LlmProvider) ---
LLM_PROVIDER=gemini            # gemini | deepseek | ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Sandbox / verification (wired in C7) ---
SANDBOX_TARGET_URL=            # set in C7
SANDBOX_SEED_USERS=./sandbox/seed-users.json
VERIFICATION_ENABLED=false     # flips true in C7
