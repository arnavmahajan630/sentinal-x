{
  "name": "sentinel-x",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:dashboard",
    "dev:server": "npm run dev -w @sentinelx/server",
    "dev:dashboard": "npm run dev -w @sentinelx/dashboard",
    "build": "npm run build -w @sentinelx/server && npm run build -w @sentinelx/dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "llm:ping": "npm run llm:ping -w @sentinelx/engine",
    "index": "npm run index -w @sentinelx/engine --",
    "graph": "npm run graph -w @sentinelx/engine --"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "npm-run-all2": "^7.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
